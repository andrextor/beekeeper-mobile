{
  "name": "beekeeper-mobile",
  "version": "0.2.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "ci:check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "aes-js": "^3.1.2",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.15",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-network": "~58.0.4",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "lucide-react-native": "^1.61.0",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/aes-js": "^3.1.4",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.20",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
