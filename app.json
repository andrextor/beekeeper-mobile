{
  "expo": {
    "name": "Landak Apiario",
    "slug": "landak-apiario",
    "version": "0.11.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "landak",
    "userInterfaceStyle": "light",
    "android": {
      "package": "co.landak.apiario",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#0c6511",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "La cámara lee el código QR de cada colmena.",
          "recordAudioAndroid": false
        }
      ],
      "expo-speech-recognition"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d89ae7ab-acdc-4c2c-b987-3064f1553a9e"
      }
    },
    "owner": "andrextors-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d89ae7ab-acdc-4c2c-b987-3064f1553a9e",
      "checkAutomatically": "ON_LOAD"
    }
  }
}
